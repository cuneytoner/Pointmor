# Pointmor production stack — copy to infra/docker/.env.prod (do not commit)
# Usage (repo root):
# docker compose -f infra/docker/docker-compose.prod.yml --env-file infra/docker/.env.prod up -d

# --- Image refs (immutable recommended: tag@sha256:digest) ---
POINTMOR_API_IMAGE=ghcr.io/your-org/pointmor-api:sha-REPLACE_ME
POINTMOR_ADMIN_IMAGE=ghcr.io/your-org/pointmor-admin-web:sha-REPLACE_ME

# --- Runtime network / ports (behind reverse proxy/TLS terminator) ---
API_HOST_PORT=3000
ADMIN_HOST_PORT=8080

# --- Required core runtime ---
APP_ENV=production
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://pointmor_prod:CHANGE_ME@postgres-prod:5432/pointmor_prod
CORS_ORIGINS=https://app.example.com,https://customer.example.com
PUBLIC_API_BASE_URL=https://api.example.com

# --- Required secrets (set strong random values) ---
COOKIE_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
CUSTOMER_PORTAL_JWT_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM
POINTMOR_PREFLIGHT_SECRET=CHANGE_ME_PREFLIGHT_SECRET
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET

# Enable these only when internal scheduled jobs are used.
# At least one must be configured for /internal/jobs/* routes to be registered.
RETENTION_JOB_SECRET=
HQ_INSIGHT_JOB_SECRET=

# --- Security policy (strict production defaults) ---
CUSTOMER_SESSION_MODE=cookie
CUSTOMER_ALLOW_BEARER_FALLBACK=false
WEBHOOK_AUTH_MODE=hmac
WEBHOOK_ALLOW_LEGACY_SECRET=false
INTERNAL_JOB_REQUIRE_HMAC=true
INTERNAL_JOB_REQUIRE_TIMESTAMP=true
INTERNAL_JOB_TIMESTAMP_SKEW_SEC=300
POINTMOR_PREFLIGHT_ALLOW_QUERY=false
ALLOW_HEALTH_SECURITY_SUMMARY=true
ENABLE_HSTS=true

# Rollout cutoff dates (ISO 8601 UTC)
CUSTOMER_PORTAL_JTI_REQUIRED_AFTER=2026-10-01T00:00:00.000Z
CUSTOMER_BEARER_LEGACY_SUNSET_AFTER=2026-10-15T00:00:00.000Z
INTERNAL_JOB_LEGACY_AUTH_EXPIRES_AT=2026-12-01T00:00:00.000Z
SECURITY_STATE_MEMORY_FALLBACK_EXPIRES_AT=2026-11-15T00:00:00.000Z

# Shared security state (production: Redis expected)
SECURITY_STATE_BACKEND=redis
REDIS_URL=redis://redis-prod:6379
SECURITY_STATE_ALLOW_MEMORY_FALLBACK=false
SECURITY_STATE_ACK_IN_PROCESS_MEMORY=false
SECURITY_STATE_MEMORY_FALLBACK_JUSTIFICATION=
SECURITY_STATE_REDIS_UNAVAILABLE_REPLAY=closed
SECURITY_STATE_REDIS_UNAVAILABLE_REVOKE_READ=closed

# API limits (optional, keep defaults unless tuned)
API_RATE_LIMIT_MAX=400
PUBLIC_API_RATE_MAX=120
PUBLIC_LOYALTY_RATE_MAX=60
PUBLIC_SESSION_RATE_MAX=20
WEBHOOK_TIMESTAMP_SKEW_SEC=300

# Entrypoint migration behavior: keep false in production; run explicit migration step in deploy pipeline
RUN_MIGRATIONS_ON_START=false

# --- Optional GHCR pull auth (if registry is private) ---
GHCR_USERNAME=
GHCR_TOKEN=

