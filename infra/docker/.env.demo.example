# Pointmor demo stack — kopyalayın: infra/docker/.env.demo (git’e eklemeyin)
# Kullanım (repo kökünden): docker compose -f infra/docker/docker-compose.demo.yml --env-file infra/docker/.env.demo up -d

# --- PostgreSQL (yalnızca Docker ağı; internete açmayın) ---
POSTGRES_DEMO_USER=pointmor_demo
POSTGRES_DEMO_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DEMO_DB=pointmor_demo
# VM’de yalnızca localhost: host’tan seed için 127.0.0.1’e map
POSTGRES_DEMO_PORT=55432

# API — compose içi hostname
# Şifrede özel karakter varsa URL-encode edin veya şifreyi sade tutun.
DATABASE_URL_DEMO=postgresql://pointmor_demo:CHANGE_ME_LONG_RANDOM@postgres-demo:5432/pointmor_demo

# --- API güvenlik (üretimde asla örnek değer kullanmayın) ---
COOKIE_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
CUSTOMER_PORTAL_JWT_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM
# Müşteri session modu: cookie (önerilen) veya dual (legacy bearer+cookie)
CUSTOMER_SESSION_MODE=cookie
# Cookie-only iken Bearer’ı tekrar açmak (geçiş / debug); prod’da false önerilir
CUSTOMER_ALLOW_BEARER_FALLBACK=false

# Opsiyonel Redis (compose profile: redis) — replay + oturum iptali için
# REDIS_URL=redis://redis-demo:6379
# SECURITY_STATE_BACKEND=auto
# SECURITY_STATE_REDIS_UNAVAILABLE=closed

# Smoke / otomasyon: login yanıtında token yok; çerez kullanılır (ADMIN_LOGIN_INCLUDE_TOKEN=false önerilir)
# ADMIN_LOGIN_INCLUDE_TOKEN=false

# Internal job’lar için webhook-parity HMAC (body JSON string); varsayılan legacy secret
# INTERNAL_JOB_REQUIRE_HMAC=false
# Webhook auth modu: hmac (önerilen) veya legacy-secret (geçiş)
WEBHOOK_AUTH_MODE=hmac
# TLS terminasyonu API önünde ise (ör. Cloudflare “Full strict”): API yanıtlarına HSTS eklenir
# ENABLE_HSTS=true

# Admin SPA build: tarayıcının göreceği API kök URL (https, sondaki / yok)
PUBLIC_API_BASE_URL=https://api-demo.example.com

# CORS: admin ve müşteri PWA kökenleri (virgülle)
CORS_ORIGINS=https://demo.example.com,https://app-demo.example.com

# Konteyner açılışında prisma migrate deploy
RUN_MIGRATIONS_ON_START=true

API_HOST_PORT=3000
ADMIN_HOST_PORT=8080

# Cloudflare Tunnel — compose: --profile cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# Demo seed: infra/scripts/seed-demo.sh — api-demo konteyneri içinde çalışır; DEMO_* + DATABASE_URL_DEMO yeterli.
# DEMO_ADMIN_PASSWORD=   # ≥12 karakter
# DEMO_OPERATOR_PASSWORD=
# DEMO_ADMIN_EMAIL=      # isteğe bağlı; varsayılan admin-demo@pointmor.demo
# DEMO_OPERATOR_EMAIL=
# Yerel makineden doğrudan npm seed (opsiyonel): DATABASE_URL_SEED — bkz. docs/40-guide-004-demo-deployment.md
# DATABASE_URL_SEED=postgresql://pointmor_demo:CHANGE_ME_LONG_RANDOM@127.0.0.1:55432/pointmor_demo
