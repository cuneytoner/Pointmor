# -----------------------------------------------------------------------------
# Royalty monorepo — örnek ortam değişkenleri
# Kopyalayın: apps/admin-web/.env.local ve apps/api/.env (bu dosyadan).
# API için ayrıntılı şablon: apps/api/.env.example
# -----------------------------------------------------------------------------

# --- Admin web (Vite; önek VITE_)
# Geliştirmede API tabanı. Tarayıcıdan istekler bu adrese gider; CORS için API
# tarafında aynı origin’i CORS_ORIGINS içine ekleyin.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Pazarlama sitesi (hesap oluştur, ödeme veya haftalık sınırlı ücretsiz seçimi)
# VITE_MARKETING_BASE_URL=https://www.sirketiniz.com

# --- API (Fastify + Prisma)
# Örnek: aynı LAN’daki VM’deki Docker Postgres (postgre.sh ile uyumlu host/port/db)
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@192.168.1.20:5432/devdb"
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/devdb"
PORT=3000
# CORS: virgülle ayrılmış izin verilen kökenler. Admin dev sunucusu için
# tek origin kullanın (ör. hep 127.0.0.1 veya hep localhost) — localStorage
# farklı origin’lerde paylaşılmaz.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
