{
  "name": "pointmor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace admin-web",
    "dev:portal": "npm run dev --workspace admin-web",
    "dev:api": "npm run dev --workspace api",
    "db:reset": "npm run db:reset -w api",
    "db:seed": "npm run db:seed -w api",
    "db:migrate": "npm run db:migrate -w api",
    "build": "npm run build -w @pointmor/rbac && npm run build -w api && npm run build -w admin-web",
    "test": "npm run test -w @pointmor/rbac && npm run test -w api",
    "lint": "npm run lint --workspaces --if-present",
    "ci:prisma": "npm run db:validate -w api && npm run db:generate -w api",
    "ci:i18n": "npm run i18n:validate -w admin-web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "ssh2": "^1.17.0"
  }
}
