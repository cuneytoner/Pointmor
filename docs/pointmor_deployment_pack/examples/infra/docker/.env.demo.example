# Image tags
IMAGE_TAG=demo-latest

# Postgres
POSTGRES_DB=pointmor_demo
POSTGRES_USER=pointmor
POSTGRES_PASSWORD=change_me_strong_password

# API
COOKIE_SECRET=replace_with_strong_cookie_secret
CUSTOMER_PORTAL_JWT_SECRET=replace_with_strong_customer_portal_jwt_secret
CORS_ORIGINS=https://admin-demo.example.com,https://customer-demo.example.com
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
WEBHOOK_SECRET=replace_if_used

# Web
VITE_API_BASE_URL=https://api-demo.example.com

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=replace_with_real_tunnel_token
