// Pointmor — çekirdek SaaS (loyalty ürün alanı sonraki fazda)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  free
  pro
  team
}

model Tenant {
  id                      String    @id @default(cuid())
  slug                    String    @unique
  name                    String
  onboardingStep          Int       @default(1)
  onboardingCompletedAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  users          User[]
  subscriptions  Subscription[]
  customers         Customer[]
  loyaltyAccounts   LoyaltyAccount[]
  pointsLedgers     PointsLedger[]
  visits            Visit[]
  rewards                  Reward[]
  redemptions              Redemption[]
  campaigns                Campaign[]
  visitCampaignApplications VisitCampaignApplication[]
  loyaltyDomainEvents       LoyaltyDomainEvent[]
  customerActions           CustomerAction[]
  productAnalyticsEvents    ProductAnalyticsEvent[]
  branches                  Branch[]
  deviceSessions            DeviceSession[]
  cashierShifts             CashierShift[]
  auditEvents               AuditEvent[]
  anomalySignals            AnomalySignal[]
  storeSettings             StoreSettings?
  menuCategories            MenuCategory[]
  menuItems                 MenuItem[]
  storeMessagingSettings    StoreMessagingSettings?
  notificationDeliveries    NotificationDelivery[]
  customerContactPreferences CustomerContactPreference[]
  messageTemplateOverrides  TenantMessageTemplateOverride[]
  retentionSettings         TenantRetentionSettings?
  hqInsights                HqInsight[]
  automationSettings        TenantAutomationSettings?
  hqAutomationActions         HqAutomationAction[]
}

/// Kiracı bazlı veri saklama (plan katmanına göre min/max doğrulanır).
model TenantRetentionSettings {
  id     String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationalAuditDays Int
  exportAuditDays      Int
  messagingDays        Int
  anomalyDays          Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// HQ AI önerileri — batch job üretir; kullanıcı dismiss edebilir.
model HqInsight {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  type            String
  severity        String    @default("info")
  message         String
  suggestedAction String
  actionKind      String
  payload         Json      @default("{}")
  dedupeKey       String
  dismissedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, dismissedAt, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
}

/// HQ otomasyon modu ve güvenlik tavanı (kiracı başına tek kayıt).
model TenantAutomationSettings {
  id     String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// suggest_only | approval_required | auto_apply
  mode   String @default("approval_required")
  maxActionsPerDay Int @default(5)
  cooldownMinutes  Int @default(360)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Insight / kural motorundan gelen otomatik aksiyon (onay veya doğrudan uygulama).
model HqAutomationAction {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// visit_drop | low_activity | retention_gap | anomaly
  triggerType    String
  ruleKey        String
  /// create_campaign | messaging_send | config_update
  actionType     String
  /// pending | approved | rejected | completed | failed | skipped
  status         String      @default("pending")
  idempotencyKey String
  payload        Json        @default("{}")
  hqInsightId    String?
  result         Json?
  errorMessage   String?
  reviewedAt     DateTime?
  reviewedByUserId String?
  executedAt     DateTime?
  source         String      @default("rule_engine")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
}

/// Mağaza vitrin ayarları — tenant başına tek kayıt.
model StoreSettings {
  id     String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  storeName    String
  logoUrl      String?
  primaryColor String  @default("#0056b3")
  defaultLanguage   String   @default("en")
  supportedLanguages String[] @default(["en", "tr"])
  currency     String @default("EUR")
  timezone     String @default("UTC")
  address      Json?

  contactPhone String?
  contactEmail String?

  loyaltyPublicEnabled Boolean @default(true)
  menuPublicEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuCategory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items MenuItem[]

  @@index([tenantId, sortOrder])
}

model MenuItem {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Para birimi alt birimi (ör. sent).
  price       Int
  currency    String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId, sortOrder])
}

/// Operasyonel denetim kaydı — tenant kapsamlı, güncellenmez (yalnızca ekleme).
enum AuditActorType {
  cashier
  manager
  system
}

enum AuditEntityType {
  visit
  redemption
  customer
  cashier_shift
  device_session
  branch
  reward
  campaign
  other
}

model AuditEvent {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actorType       AuditActorType
  branchId        String?
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deviceSessionId String?
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  cashierShiftId  String?
  cashierShift    CashierShift?  @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)
  eventType       String
  entityType      AuditEntityType
  entityId        String
  payload         Json           @default("{}")
  createdAt       DateTime       @default(now())

  linkedAnomalies AnomalySignal[]

  @@index([tenantId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([cashierShiftId])
  @@index([branchId])
  @@index([deviceSessionId])
}

/// Hafif kural tabanlı anomali bayrağı — ML / skor motoru yok.
model AnomalySignal {
  id                 String      @id @default(cuid())
  tenantId           String
  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type               String
  severity           String      @default("warn")
  branchId           String?
  branch             Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  cashierShiftId     String?
  cashierShift       CashierShift? @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payload            Json        @default("{}")
  sourceAuditEventId String?
  sourceAuditEvent   AuditEvent? @relation(fields: [sourceAuditEventId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([cashierShiftId])
  @@index([branchId])
}

// --- Loyalty (Phase 1) ---

/// Şube / lokasyon (franchise & multi-location; UI’da “Location” olarak geçer)
model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String?
  address   Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceSessions DeviceSession[]
  auditEvents    AuditEvent[]
  anomalySignals AnomalySignal[]
  visits         Visit[]
  campaigns      Campaign[]
  hqInsights     HqInsight[]
  hqAutomationActions HqAutomationAction[]
  userAccess     UserBranchAccess[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Kullanıcı → şube kapsamı (staff: tek şube; manager: çoklu; owner: satır yok = tüm şubeler)
model UserBranchAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

enum DeviceSessionStatus {
  open
  closed
}

/// Fiziksel cihaz / tablet register oturumu (şube ile ilişkilendirilebilir)
model DeviceSession {
  id              String              @id @default(cuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  deviceLabel     String
  status          DeviceSessionStatus @default(open)
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  createdByUserId String?

  cashierShifts CashierShift[]
  visits          Visit[]
  redemptions     Redemption[]
  auditEvents     AuditEvent[]

  @@index([tenantId, status])
  @@index([branchId])
}

enum CashierShiftStatus {
  open
  closed
}

/// Kasiyer vardiyası — kullanıcı + cihaz oturumu
model CashierShift {
  id              String             @id @default(cuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceSessionId String
  deviceSession   DeviceSession      @relation(fields: [deviceSessionId], references: [id], onDelete: Restrict)
  status          CashierShiftStatus @default(open)
  startedAt       DateTime           @default(now())
  endedAt         DateTime?

  visits      Visit[]
  redemptions Redemption[]
  auditEvents AuditEvent[]
  anomalies   AnomalySignal[]

  @@index([tenantId, status])
  @@index([tenantId, userId, status])
  @@index([deviceSessionId, status])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String

  anomalySignals AnomalySignal[]
  email     String?
  /// Son ziyaret zamanı (growth / inactivity kuralları)
  lastVisitAt DateTime?
  /// Toplam ziyaret sayısı (otomasyon MVP)
  visitCount  Int      @default(0)
  /// Son anlamlı etkileşim (ziyaret veya ödül talebi)
  lastActiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loyaltyAccount LoyaltyAccount?
  visits           Visit[]
  pointsLedgers    PointsLedger[]
  redemptions      Redemption[]
  loyaltyDomainEvents LoyaltyDomainEvent[]
  customerActions     CustomerAction[]
  productAnalyticsEvents ProductAnalyticsEvent[]
  contactPreference   CustomerContactPreference?
  notificationDeliveries NotificationDelivery[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, lastVisitAt])
}

model LoyaltyAccount {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String   @unique
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

enum PointsLedgerType {
  earn
  redeem
  adjust
}

enum PointsLedgerSource {
  visit
  campaign
  redemption
  manual
}

model PointsLedger {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        PointsLedgerType
  points      Int
  source      PointsLedgerSource
  referenceId String?
  visitId     String?
  visit       Visit?               @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())

  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@index([visitId])
}

model Visit {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Raporlama ve RBAC için denormalize şube (cihaz oturumundan kopyalanır)
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  amount            Int
  /// Toplam kazanılan puan (taban + kampanya bonusları)
  pointsEarned      Int
  basePointsEarned  Int
  bonusPointsEarned Int
  createdAt         DateTime @default(now())

  deviceSessionId String?
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  cashierShiftId  String?
  cashierShift    CashierShift?  @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)

  campaignApplications VisitCampaignApplication[]
  pointsLedgerRows     PointsLedger[]

  @@index([tenantId, customerId])
  @@index([tenantId, branchId])
  @@index([cashierShiftId])
  @@index([deviceSessionId])
}

enum RewardType {
  FREE_ITEM
  FIXED_DISCOUNT
  PERCENT_DISCOUNT
}

enum RewardValueType {
  NONE
  MINOR_AMOUNT
  PERCENT_BP
}

enum RedemptionMethod {
  POINTS_ONLY
}

enum RedemptionStatus {
  pending
  completed
  rejected
}

model Reward {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  pointsCost       Int
  rewardType       RewardType        @default(FREE_ITEM)
  valueType        RewardValueType   @default(NONE)
  value            Int               @default(0)
  redemptionMethod RedemptionMethod  @default(POINTS_ONLY)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  redemptions Redemption[]

  @@index([tenantId])
}

enum CampaignType {
  BONUS_POINTS
  SPEND_THRESHOLD_BONUS
  FIRST_VISIT_BONUS
}

enum CampaignStatus {
  draft
  active
  paused
  archived
}

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// null = tüm şubeler; dolu = yalnızca bu şubede geçerli override
  branchId    String?
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  description String?
  type        CampaignType
  status      CampaignStatus @default(draft)
  startAt     DateTime?
  endAt       DateTime?
  config      Json
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  visitApplications VisitCampaignApplication[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

model VisitCampaignApplication {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId       String
  visit         Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  pointsAwarded Int
  createdAt     DateTime @default(now())

  @@unique([visitId, campaignId])
  @@index([tenantId])
  @@index([campaignId])
}

model Redemption {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardId    String
  reward      Reward            @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  pointsSpent Int
  status      RedemptionStatus  @default(completed)
  createdAt   DateTime          @default(now())

  deviceSessionId String?
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  cashierShiftId  String?
  cashierShift    CashierShift?  @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([rewardId])
  @@index([tenantId, status])
  @@index([cashierShiftId])
  @@index([deviceSessionId])
}

// --- Growth & automation (Phase 4) ---

enum LoyaltyDomainEventType {
  visit_created
  reward_claimed
  inactivity_detected
}

/// Domain event (audit + rule tetikleyici)
model LoyaltyDomainEvent {
  id         String                 @id @default(cuid())
  tenantId   String
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       LoyaltyDomainEventType
  payload    Json                   @default("{}")
  createdAt  DateTime               @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

enum CustomerActionStatus {
  pending
  sent
  failed
}

/// Otomasyon çıktısı — bildirim kanalı ileride eklenebilir; şimdilik log/simulate
model CustomerAction {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  message    String
  /// Şablon anahtarı (örn. DAY_1_REMINDER); yoksa type üzerinden eşlenir
  templateKey String?
  /// `renderTemplate` için değişkenler (JSON)
  templateData Json?
  status     CustomerActionStatus @default(pending)
  createdAt  DateTime             @default(now())

  notificationDeliveries NotificationDelivery[]

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

// --- Messaging & notifications (Twilio Verify / SMS / delivery log) ---

enum ContactPreferredChannel {
  sms
  whatsapp
  none
}

/// Müşteri iletişim tercihi + doğrulanmış telefon (session için verifiedAt zorunlu)
model CustomerContactPreference {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String  @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Müşteri kaydıyla uyumlu denormalize (arama / rapor)
  phone     String
  smsOptIn  Boolean  @default(false)
  whatsappOptIn Boolean @default(false)
  preferredChannel ContactPreferredChannel @default(none)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, phone])
}

enum NotificationChannel {
  sms
  whatsapp
}

enum NotificationProviderId {
  twilio
}

enum NotificationDeliveryStatus {
  queued
  sent
  delivered
  failed
}

/// Zincirin nihai sonucu (yalnızca terminal satırda dolu)
enum NotificationDeliveryFinalOutcome {
  succeeded
  failed
}

/// Sınıflandırma — log / rapor (PII yok)
enum NotificationFailureCategory {
  none
  validation
  opt_in
  quiet_hours
  provider_transient
  provider_permanent
  configuration
  rate_limited
  unknown
}

/// Gönderim kaydı (Twilio SID referansları; auth token DB’de tutulmaz)
model NotificationDelivery {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerActionId String?
  customerAction   CustomerAction? @relation(fields: [customerActionId], references: [id], onDelete: SetNull)
  channel    NotificationChannel
  provider   NotificationProviderId @default(twilio)
  providerMessageId String?
  status     NotificationDeliveryStatus @default(queued)
  errorCode  String?
  payloadSummary Json?
  /// Bu mantıksal gönderimdeki deneme sırası (1 tabanlı; kanal değişimi + retry dahil)
  attemptNumber Int @default(1)
  /// Fallback: bir önceki kanaldaki başarısız delivery satırı
  fallbackFromId String?
  fallbackParent NotificationDelivery? @relation("NotificationDeliveryFallback", fields: [fallbackFromId], references: [id], onDelete: SetNull)
  fallbackChildren NotificationDelivery[] @relation("NotificationDeliveryFallback")
  /// Aynı kanalda geçici hata sonrası retry zinciri
  retryOfId String?
  retryParent NotificationDelivery? @relation("NotificationDeliveryRetry", fields: [retryOfId], references: [id], onDelete: SetNull)
  retryChildren NotificationDelivery[] @relation("NotificationDeliveryRetry")
  /// Yalnızca müşteri aksiyonu için nihai satırda: başarı veya tüm seçenekler tükendi
  finalOutcome NotificationDeliveryFinalOutcome?
  failureCategory NotificationFailureCategory @default(none)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([customerActionId])
  @@index([fallbackFromId])
  @@index([retryOfId])
}

enum StoreMessagingDefaultChannel {
  sms
  whatsapp
}

/// Kiracı başına tek — Twilio Verify / Messaging servis SID’leri (gizli anahtar env’de)
model StoreMessagingSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  smsEnabled Boolean @default(false)
  whatsappEnabled Boolean @default(false)
  defaultChannel StoreMessagingDefaultChannel @default(sms)
  twilioVerifyServiceSid     String?
  twilioMessagingServiceSid  String?
  whatsappSender String?
  fromNumber    String?
  /// OTP zorunlu müşteri oturumu (PWA); false iken legacy telefon ile session mümkün (dev)
  requireVerifiedForSession Boolean @default(false)
  /// Birincil kanal başarısız olursa (ileride) ikincil kanala izin
  allowFallbackChannel Boolean @default(true)
  /// Sessiz saat başlangıç/bitiş — kiracı `timezone` içinde "HH:mm"
  quietHoursStart String?
  quietHoursEnd   String?
  timezone        String @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Global varsayılan mesaj şablonları (tenant silinemez; yalnızca override)
model MessageTemplate {
  id             String               @id @default(cuid())
  key            String
  channel        NotificationChannel
  defaultContent String
  variables      String[]             @default([])
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([key, channel])
  @@index([key])
}

/// Kiracı başına şablon üzerine yazma
model TenantMessageTemplateOverride {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateKey String
  channel     NotificationChannel
  content     String
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, templateKey, channel])
  @@index([tenantId])
}

// --- Phase 4.5 — ürün analitiği (davranış / funnel / retention; harici araç yok) ---

enum ProductAnalyticsEventType {
  qr_opened
  customer_viewed_home
  visit_recorded
  points_awarded
  reward_viewed
  reward_claimed
  redemption_completed
}

model ProductAnalyticsEvent {
  id         String                   @id @default(cuid())
  tenantId   String
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Anonim QR yüklemelerinde null olabilir
  customerId String?
  customer   Customer?                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       ProductAnalyticsEventType
  payload    Json                     @default("{}")
  createdAt  DateTime                 @default(now())

  @@index([tenantId, type, createdAt])
  @@index([tenantId, customerId, createdAt])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  platformAdmin  Boolean  @default(false)
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  role           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cashierShifts CashierShift[]
  branchAccess  UserBranchAccess[]

  @@index([tenantId])
}

model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  priceCents  Int
  currency    String   @default("EUR")
  interval    String
  planType    PlanType @default(free)
  featureTags String[] @default([])
  /// Loyalty limitleri (JSON). Boş veya eksik anahtarlar plan slug/planType varsayılanları ile tamamlanır; null = sınırsız.
  limits      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  status    String
  renewsAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([planId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String?
  action     String
  detail     String?
  createdAt  DateTime @default(now())
}
