# apps/api — kopyalayın: .env (git'e eklenmez)
# Kök .env.example ile aynı mantık; Prisma ve API yalnızca bu dosyayı kullanır (cwd: apps/api).

PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Oturum: HttpOnly çerez imzası (@fastify/cookie). Üretimde güçlü rastgele değer kullanın.
COOKIE_SECRET=change-me-in-production

# Admin oturum backend: production’da varsayılan imzalı (stateless). Yerel/test: memory
# SESSION_BACKEND=memory | signed
# İmzalı oturum için ayrı sırra izin verir (yoksa COOKIE_SECRET kullanılır)
# SESSION_SIGNING_SECRET=
# SESSION_TTL_SECONDS=604800

# TLS terminasyonu API önünde ise: Strict-Transport-Security
# ENABLE_HSTS=true

# Müşteri portalı JWT (HS256); üretimde COOKIE_SECRET’tan farklı güçlü bir değer önerilir.
# CUSTOMER_PORTAL_JWT_SECRET=

# Public loyalty uçları için ek dakika başına limit (varsayılan 60)
# PUBLIC_LOYALTY_RATE_MAX=60

# Phase 3 — /public/tenants/:slug/* (varsayılan 120 dk başına)
# PUBLIC_API_RATE_MAX=120

# Telefon ile oturum (brute-force azaltma; varsayılan 20 dk başına)
# PUBLIC_SESSION_RATE_MAX=20

# Genel API rate limit (dakika başına istek; /health hariç)
# API_RATE_LIMIT_MAX=400

# Webhook iskeleti: X-Webhook-Secret veya Authorization Bearer ile aynı değer
# WEBHOOK_SIGNING_SECRET=
# Zaman damgası zorunlu (replay azaltma): X-Webhook-Timestamp (unix sn)
# WEBHOOK_REQUIRE_TIMESTAMP=true

# Loyalty: ziyaret tutarı (küçük birim) başına kaç küçük birim = 1 puan (varsayılan 100 → 1,00 = 1 puan)
# LOYALTY_MINOR_UNITS_PER_POINT=100

# Tenant App — demo plan değişimi (POST /tenant/billing/demo-plan-switch; gerçek ödeme yok).
# Secure-by-default: yalnızca ALLOW_TENANT_DEMO_PLAN_SWITCH=true ve (APP_ENV=demo veya NODE_ENV≠production).
# ALLOW_TENANT_DEMO_PLAN_SWITCH=false

# Internal job replay azaltma (Retention / HQ insights): unix sn header zorunlu
# INTERNAL_JOB_REQUIRE_TIMESTAMP=true

# PostgreSQL — seed ve migration bu bağlantıya gider.
# Yerel örnek:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/devdb"
# Uzak VM / Docker örneği:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@192.168.1.20:5432/devdb"

DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/devdb"

# --- Data retention (günlük job: npm run job:retention veya POST /internal/jobs/retention) ---
# RETENTION_JOB_SECRET= # tanımlıysa internal job ucu açılır; X-Retention-Job-Secret veya Bearer
# RETENTION_EXPORT_AUDIT_DAYS=30
# RETENTION_OPERATIONAL_AUDIT_DAYS=90
# RETENTION_ANOMALY_DAYS=60
# RETENTION_MESSAGING_DELIVERY_DAYS=45
# RETENTION_PLATFORM_AUDIT_LOG_DAYS=90
# RETENTION_PRODUCT_ANALYTICS_DAYS=180
# Bir tablo için otomatik silmeyi kapatmak: never | off | 0
# RETENTION_PRODUCT_ANALYTICS_DAYS=never
# RETENTION_CLEANUP_BATCH_SIZE=500
# RETENTION_CLEANUP_MAX_BATCHES_PER_TABLE=2000
