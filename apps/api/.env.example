# apps/api — kopyalayın: .env (git'e eklenmez)
# Kök .env.example ile aynı mantık; Prisma ve API yalnızca bu dosyayı kullanır (cwd: apps/api).

PORT=3000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Oturum: HttpOnly çerez imzası (@fastify/cookie). Üretimde güçlü rastgele değer kullanın.
COOKIE_SECRET=change-me-in-production

# Admin oturum backend: production’da varsayılan imzalı (stateless). Yerel/test: memory
# SESSION_BACKEND=memory | signed
# İmzalı oturum için ayrı sır (yoksa COOKIE_SECRET). Rotation için:
# SESSION_SIGNING_KEYS="v2:new-secret,v1:old-secret"
# SESSION_SIGNING_ACTIVE_KID=v2
# SESSION_SIGNING_SECRET=
# SESSION_TTL_SECONDS=604800
# Cookie-only admin geçişi için login response token davranışı (prod/demo varsayılanı: false)
# ADMIN_LOGIN_INCLUDE_TOKEN=false

# Paylaşımlı güvenlik durumu: replay + oturum iptali (Redis önerilir; multi-instance)
# REDIS_URL=redis://127.0.0.1:6379
# SECURITY_STATE_BACKEND=auto # auto | memory | redis
# NODE_ENV=production veya APP_ENV=demo iken bellek modu: iki açık onay gerekir
# SECURITY_STATE_ALLOW_MEMORY_FALLBACK=true
# SECURITY_STATE_ACK_IN_PROCESS_MEMORY=true
# SECURITY_STATE_MEMORY_FALLBACK_JUSTIFICATION=demo-week-12-single-node
# SECURITY_STATE_BACKEND=redis → REDIS_URL zorunlu (sessiz memory düşüşü yok)
# SECURITY_STATE_REDIS_UNAVAILABLE=closed # legacy: revoke okuma + replay birlikte
# SECURITY_STATE_REDIS_UNAVAILABLE_REPLAY=closed # Redis replay hatası: bellek fallback yalnızca open ise
# SECURITY_STATE_REDIS_UNAVAILABLE_REVOKE_READ=closed # Redis revoke okuma: fail-open yalnızca open ise
# ALLOW_HEALTH_SECURITY_SUMMARY=true + GET /health?securitySummary=1 → metrikler; strict’te tam policy için:
# POINTMOR_PREFLIGHT_SECRET=... ve istekte X-Pointmor-Preflight-Secret (veya ?preflightSecret=)

# Bearer legacy: bu tarihten sonra Bearer kapatılır (cookie çalışır)
# CUSTOMER_BEARER_LEGACY_SUNSET_AFTER=2026-10-15T00:00:00.000Z

# Internal job legacy secret modu: bu tarihten sonra başarısız startup (HMAC’e geçin)
# INTERNAL_JOB_LEGACY_AUTH_EXPIRES_AT=2026-12-01T00:00:00.000Z

# Müşteri JWT: jti zorunluluğu için kesim (ISO 8601); önce uyarı metrikleri, sonra reddetme
# CUSTOMER_PORTAL_JTI_REQUIRED_AFTER=2026-09-01T00:00:00.000Z

# Müşteri API: cookie-only modda Bearer varsayılan kapalı; geçiş için:
# CUSTOMER_ALLOW_BEARER_FALLBACK=true

# Internal job (retention / hq-insights) HMAC: webhook ile aynı imza modeli (raw JSON body)
# INTERNAL_JOB_REQUIRE_HMAC=false
# INTERNAL_JOB_TIMESTAMP_SKEW_SEC=300
# INTERNAL_JOB_LEGACY_AUTH_ACKNOWLEDGED=true # HMAC kapalıyken uyarı bastırmak için (geçiş)

# TLS terminasyonu API önünde ise: Strict-Transport-Security
# ENABLE_HSTS=true

# Müşteri portalı JWT (HS256); üretimde COOKIE_SECRET’tan farklı güçlü bir değer önerilir.
# CUSTOMER_PORTAL_JWT_SECRET=
# CUSTOMER_PORTAL_TOKEN_TTL_SECONDS=43200
# CUSTOMER_SESSION_MODE=cookie # cookie | dual (prod/demo varsayılanı cookie)

# Admin imzalı oturum: stateless imza + paylaşımlı revoke (Redis) — uzun vadede sunucu oturumu / RLS ile güçlendirilebilir.

# Public loyalty uçları için ek dakika başına limit (varsayılan 60)
# PUBLIC_LOYALTY_RATE_MAX=60

# Phase 3 — /public/tenants/:slug/* (varsayılan 120 dk başına)
# PUBLIC_API_RATE_MAX=120

# Telefon ile oturum (brute-force azaltma; varsayılan 20 dk başına)
# PUBLIC_SESSION_RATE_MAX=20

# Genel API rate limit (dakika başına istek; /health hariç)
# API_RATE_LIMIT_MAX=400

# Webhook HMAC: payload = "<unix_ts>.<raw_json_body>", signature = x-webhook-signature: v1=<hex>
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_AUTH_MODE=hmac # hmac | legacy-secret
# WEBHOOK_TIMESTAMP_SKEW_SEC=300
# WEBHOOK_ALLOW_LEGACY_SECRET=false

# Loyalty: ziyaret tutarı (küçük birim) başına kaç küçük birim = 1 puan (varsayılan 100 → 1,00 = 1 puan)
# LOYALTY_MINOR_UNITS_PER_POINT=100

# Tenant App — demo plan değişimi (POST /tenant/billing/demo-plan-switch; gerçek ödeme yok).
# Secure-by-default: yalnızca ALLOW_TENANT_DEMO_PLAN_SWITCH=true ve (APP_ENV=demo veya NODE_ENV≠production).
# ALLOW_TENANT_DEMO_PLAN_SWITCH=false

# Internal job replay azaltma (Retention / HQ insights): unix sn header zorunlu
# INTERNAL_JOB_REQUIRE_TIMESTAMP=true

# PostgreSQL — seed ve migration bu bağlantıya gider.
# Yerel örnek:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/devdb"
# Uzak VM / Docker örneği:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@192.168.1.20:5432/devdb"

DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/devdb"

# --- Data retention (günlük job: npm run job:retention veya POST /internal/jobs/retention) ---
# RETENTION_JOB_SECRET= # tanımlıysa internal job ucu açılır; X-Retention-Job-Secret veya Bearer
# RETENTION_EXPORT_AUDIT_DAYS=30
# RETENTION_OPERATIONAL_AUDIT_DAYS=90
# RETENTION_ANOMALY_DAYS=60
# RETENTION_MESSAGING_DELIVERY_DAYS=45
# RETENTION_PLATFORM_AUDIT_LOG_DAYS=90
# RETENTION_PRODUCT_ANALYTICS_DAYS=180
# Bir tablo için otomatik silmeyi kapatmak: never | off | 0
# RETENTION_PRODUCT_ANALYTICS_DAYS=never
# RETENTION_CLEANUP_BATCH_SIZE=500
# RETENTION_CLEANUP_MAX_BATCHES_PER_TABLE=2000
